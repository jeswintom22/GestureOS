# GestureOS — Environment Configuration
# --------------------------------------
# Copy this file to `.env` (the `.env` file is git-ignored) and adjust values.
# All variables are optional; defaults from config.py are used when unset.
# Real environment variables always take precedence over this file.

# --- Logging ---------------------------------------------------------------
# Log level: DEBUG | INFO | WARNING | ERROR
GESTUREOS_LOG_LEVEL=INFO
# Silence noisy third-party loggers (e.g. screen-brightness-control EDID
# warnings) so they don't spam the console.
GESTUREOS_QUIET_THIRD_PARTY_WARNINGS=true

# --- Camera ----------------------------------------------------------------
GESTUREOS_CAMERA_INDEX=0
GESTUREOS_CAMERA_WIDTH=640
GESTUREOS_CAMERA_HEIGHT=480
GESTUREOS_CAMERA_FPS=30

# --- MediaPipe Hands -------------------------------------------------------
GESTUREOS_MP_MAX_HANDS=1
GESTUREOS_MP_MIN_DETECTION_CONFIDENCE=0.7
GESTUREOS_MP_MIN_TRACKING_CONFIDENCE=0.7

# --- Gesture thresholds ----------------------------------------------------
GESTUREOS_PINCH_THRESHOLD=0.05
GESTUREOS_RIGHT_CLICK_THRESHOLD=0.05
GESTUREOS_SWIPE_VELOCITY_THRESHOLD=0.15
GESTUREOS_SCROLL_SENSITIVITY=3
GESTUREOS_DRAG_HOLD_FRAMES=5
# How long the hand may be absent (ms) before it is declared "lost".
GESTUREOS_HAND_LOST_GRACE_MS=200

# --- Cursor mapping --------------------------------------------------------
# One Euro filter — adaptive cursor smoothing.
# Lower min cutoff = more smoothing at rest; higher beta = less lag in motion.
GESTUREOS_ONE_EURO_MIN_CUTOFF=1.0
GESTUREOS_ONE_EURO_BETA=0.05
GESTUREOS_ONE_EURO_D_CUTOFF=1.0
# Cursor dead zone in screen pixels — suppresses micro-jitter (3–6 recommended).
GESTUREOS_CURSOR_DEAD_ZONE_PX=4
GESTUREOS_CURSOR_DEAD_ZONE=0.02
GESTUREOS_CURSOR_FRAME_MARGIN=0.1

# --- Volume & Brightness ---------------------------------------------------
GESTUREOS_VOLUME_STEP=0.05
GESTUREOS_BRIGHTNESS_STEP=5

# --- Models (absolute or project-relative paths) ----------------------------
# GESTUREOS_HAND_LANDMARKER_MODEL=models/hand_landmarker.task
# GESTUREOS_VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15

# --- Voice — Vosk -----------------------------------------------------------
GESTUREOS_VOICE_SAMPLE_RATE=16000
GESTUREOS_VOICE_CHUNK_SIZE=4096

# --- HUD -------------------------------------------------------------------
GESTUREOS_HUD_WIDTH=260
GESTUREOS_HUD_HEIGHT=80
GESTUREOS_HUD_PADDING=20
GESTUREOS_HUD_FADE_MS=2000
GESTUREOS_HUD_POLL_MS=50
GESTUREOS_HUD_BG_COLOR=#1a1a2e
GESTUREOS_HUD_TEXT_COLOR=#00ff88

# --- Debug -----------------------------------------------------------------
GESTUREOS_DEBUG_SHOW_CAMERA=false
GESTUREOS_DEBUG_LOG_GESTURES=false
GESTUREOS_DEBUG_LOG_VOICE=false
